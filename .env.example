# Copy to .env.local and fill in. Never commit .env.local.
# Nothing is needed for the frontend stage; these arrive in the backend stage.

# Firebase (client config is public; the service account is secret)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Paystack (use test keys outside production)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Gemini
GEMINI_API_KEY=

# Email
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
