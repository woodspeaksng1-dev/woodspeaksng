# Copy to .env.local and fill in. Never commit .env.local.

# Firebase web config (public: Project settings → General → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Admin (SECRET: Project settings → Service accounts → Generate new private key),
# the whole JSON file on one line
FIREBASE_SERVICE_ACCOUNT_JSON=

# Paystack (SECRET key; use test keys outside production: Settings → API Keys & Webhooks)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Email (SECRET: Resend → API Keys). Until woodspeaks.ng is verified in Resend, the sender must be
# onboarding@resend.dev and mail only reaches the Resend account's own address.
RESEND_API_KEY=
EMAIL_FROM=
ORDER_NOTIFICATION_EMAIL=

# Daily reminder job (SECRET: any long random string, e.g. `openssl rand -hex 32`). Vercel sends it to
# /api/cron/daily (reminders and customer email batches); without it the job refuses to run. Production only.
CRON_SECRET=

# Customer update emails sent per day (optional, default 70). Resend's free plan allows 100 a day in all;
# raise this on a paid plan.
BROADCAST_DAILY_LIMIT=
