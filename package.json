{
  "name": "woodspeaks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "media": "node scripts/scan-media.mjs",
    "predev": "node scripts/scan-media.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/scan-media.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --exclude 'tests/rules/**' --exclude 'tests/emulator/**'",
    "emulators": "node scripts/with-java.mjs npx firebase emulators:start --project demo-woodspeaks",
    "test:emulator": "node scripts/with-java.mjs npx firebase emulators:exec --only firestore --project demo-woodspeaks \"vitest run --no-file-parallelism tests/rules tests/emulator\""
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "motion": "^14.5.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "^15.35.0",
    "opentype.js": "^2.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
